######################
packages/FOGService.msi
packages/web/client/FOGService.msi
packages/web/management/bower_components
packages/web/management/dist
packages/web/service/ipxe/*Image*
packages/web/service/ipxe/init*.xz
packages/web/service/ipxe/*.sha256
rpttmp
tmp/*

