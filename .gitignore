packages/web/service/ipxe/backup

# Config file #
###############
*config.class.php
# Written by the installer from $fogprogramdir (GH-850), like config.class.php
packages/web/commons/fogpaths.php
# Generated from the commit graph by .githooks/lib/write-version-file.sh --
# on commit, checkout and merge, and by bin/installfog.sh. FOG_VERSION is
# `git rev-list master..HEAD --count`, so a tracked copy differs per branch,
# lives on one line, and makes every pair of open branches conflict on it
# (GH-1510, GH-1513). src/Base/System.php falls back to the release constants
# it carries when this file is absent.
packages/web/commons/version.php
*.well-known
packages/web/fog
packages/web/.vscode
.vscode/settings.json


