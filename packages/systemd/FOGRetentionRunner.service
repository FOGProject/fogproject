### BEGIN INIT INFO
# Provides: FOGRetentionRunner
# Required-Start: $local_fs $remote_fs $network $syslog $network $inetd
# Required-Stop: $local_fs $remote_fs $network $syslog $network $inetd
# Default-Start: 2 3 4 5
# Default-Stop: 0 1 6
# X-Interactive: true
# Short-Description: Start/Stop FOGRetentionRunner
# Long-Description: Ages out the tables that record what happened -- the audit
# trail, the administrative history, the host login records and the task log.
# Stopping or disabling this unit stops that pruning; nothing else does it.
### END INIT INFO

[Unit]
Description=FOGRetentionRunner
After=syslog.target network.target network-online.target mysql.service
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=always
RestartSec=1
# Like FOGPluginRunner and unlike the other seven, this daemon does not run as
# root. It needs a database connection and nothing else -- no filesystem, no
# network, no process control -- so there is no reason for it to be able to do
# more than that.
#
# FOGWEBUSER is a placeholder installInitScript() rewrites to $apacheuser in
# the INSTALLED copy, never here. If that substitution does not happen systemd
# refuses to start the unit on an unknown user, which is the intended failure:
# loud, rather than silently falling back to root.
User=FOGWEBUSER
Group=FOGWEBUSER
ExecStart=/usr/bin/env php /opt/fog/service/FOGRetentionRunner/FOGRetentionRunner

[Install]
WantedBy=multi-user.target
