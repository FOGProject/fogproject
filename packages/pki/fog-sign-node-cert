#
# Issue a certificate to a storage node, from a CA the web user cannot read.
#
# Invoked through sudo by service/nodecert.php after that endpoint has
# authenticated the requesting node. The split matters: the endpoint decides
# WHO may have a certificate and for WHICH names; this decides nothing and
# holds the keys. A compromise of the web application can therefore ask for
# certificates but can never read a CA key, and every name it can ask for is
# still bounded by the CA's own name constraints.
#
# Modelled on fog-sign-kernel deliberately, including the parts that look
# paranoid:
#
#  - No path ever comes from the caller. The CA locations live in a root-only
#    config file written at install time, so the web user cannot name its own
#    key, its own output, or its own openssl config.
#  - The two arguments it does take are matched against fixed patterns before
#    anything touches the filesystem, so neither can escape the staging
#    directory or turn into an openssl option.
#  - The SAN list is re-validated here even though the endpoint built it.
#    This script is the security boundary; the thing on the other side of it
#    is the thing that might be compromised.

set -u

CONF="/opt/fog/.fog-pki"

die() { echo "$*" >&2; exit 1; }

# "signing failed" plus what openssl said, on one line. The bare phrase names
# no cause: an unreadable CA key, a key that does not match its certificate and
# a malformed request all printed the same thing, and the admin had nothing to
# check (forum topic 18318). openssl's progress lines are dropped; its error
# lines are kept, joined, because the caller shows this as a one-line toast.
sign_failed() {
    local detail
    detail=$(printf '%s\n' "$1" \
        | grep -v -e '^Certificate request self-signature ok' -e '^subject=' -e '^Signature ok' \
        | tr -s '\n' ' ')
    die "signing failed${detail:+: ${detail% }}"
}

# A random 128-bit serial for each certificate, as a CA normally assigns
# them. -CAcreateserial kept a counter in a .srl file beside the CA, and
# writing it failed where the web server's service makes /etc read-only:
# sudo runs this helper inside that same sandbox, so every approval failed
# with "Read-only file system" on .fogAgentCA.srl (forum topic 18318).
# Nothing reads the counter, so nothing needs to be written at all.
random_serial() {
    local hex
    hex=$(openssl rand -hex 16) && [[ $hex =~ ^[0-9a-f]{32}$ ]] \
        || die "could not generate a certificate serial number"
    echo "0x${hex}"
}

[[ $EUID -eq 0 ]] || die "fog-sign-node-cert must run as root"
[[ $# -eq 2 ]] || die "usage: fog-sign-node-cert <web|signing|agent> <request-id>"

type="$1"
reqid="$2"

# Validated before use, not after. A request id reaching the filesystem
# unchecked is a path traversal into whatever the web user can write.
[[ $type =~ ^(web|signing|agent)$ ]] || die "unknown certificate type"
[[ $reqid =~ ^[a-f0-9]{32}$ ]] || die "malformed request id"

[[ -r $CONF ]] || die "missing $CONF -- re-run the FOG installer"
# shellcheck disable=SC1090
. "$CONF"

: "${PKI_STAGING:=}"
[[ -d $PKI_STAGING ]] || die "staging directory is not configured"

csr="${PKI_STAGING}/${reqid}.csr"
san="${PKI_STAGING}/${reqid}.san"
out="${PKI_STAGING}/${reqid}.pem"
chainout="${PKI_STAGING}/${reqid}.chain"

# The web user owns PKI_STAGING, so it can put a symlink at any name there at
# any moment. Root must never open a path in it by name for writing, and must
# never read one in a way that follows a link: a link at the output name made
# root overwrite and chmod 0644 the file it named, and a link at the name list
# made "unrecognised name entry: <line>" print another file's lines back.
#
# So the work happens in a directory only root can reach, beside the staging
# directory, on the same filesystem. Inputs are copied in without following a
# link; outputs are written there and renamed into staging at the end. rename
# replaces a link at the destination; it never writes through one.
#
# The parent must be writable by this user alone (root, outside the tests), or
# the web user could swap the work directory itself.
parent="${PKI_STAGING%/}"
parent="${parent%/*}"
[[ -n $parent && -d $parent && ! -L $parent ]] || die "the staging directory's parent is not a directory"
[[ $(stat -c '%u' "$parent") == "$EUID" ]] && (( (8#$(stat -c '%a' "$parent") & 8#022) == 0 )) \
    || die "${parent} must be owned by root and writable only by root -- run: chown root:root ${parent} && chmod go-w ${parent}"
work=$(mktemp -d -p "$parent" .fog-sign-XXXXXXXX) || die "could not create a working directory in ${parent}"
trap 'rm -rf "$work"' EXIT

# take NAME: copy one staged request file into the work directory. nofollow
# refuses a link; nonblock keeps a FIFO from hanging the helper; 64 KiB is far
# more than any request or name list needs.
take() {
    [[ -f "${PKI_STAGING}/${reqid}.$1" ]] || return 1
    dd if="${PKI_STAGING}/${reqid}.$1" of="${work}/in.$1" iflag=nofollow,nonblock \
        bs=65536 count=1 status=none 2>/dev/null
}

take csr || die "no request at ${csr}"
csrin="${work}/in.csr"
leaf="${work}/leaf.pem"
chain="${work}/chain.pem"

# publish: move the finished pair into staging for the caller to read.
publish() {
    chmod 0644 "$leaf" "$chain" || die "could not set the certificate's permissions"
    mv -f -T "$chain" "$chainout" && mv -f -T "$leaf" "$out" \
        || die "could not move the certificate into ${PKI_STAGING}"
}

# The agent zone issues CLIENT certificates to fog-agent installs
# (FOG\Agent\Enrollment stages the request). No names: the certificate
# identifies a host record, not an address, and the only thing the endpoint
# hands over is the host id, in its own file, matched against a fixed
# pattern here before it goes anywhere near a subject line. The key it is
# signed with is the agent intermediate, never the web CA -- the web CA may
# be one the admin brought, and a public CA does not issue client
# certificates -- and clientAuth alone on the EKU means nothing issued here
# can ever pose as a server.
if [[ $type == agent ]]; then
    take agent || die "no host id at ${PKI_STAGING}/${reqid}.agent"
    hostid=$(head -n1 "${work}/in.agent" | tr -d '[:space:]')
    [[ $hostid =~ ^[0-9]{1,10}$ ]] || die "malformed host id"
    cacert="${PKI_AGENT_CA_CERT:-}"
    cakey="${PKI_AGENT_CA_KEY:-}"
    [[ -n $cacert && -f $cacert ]] || die "the agent CA is not present on this server -- re-run the FOG installer"
    [[ -n $cakey && -f $cakey ]] || die "the agent CA private key is not on this server (expected at ${cakey:-<unset>})"
    tmpext="${work}/ext.cnf"
    {
        echo "[ v3_agent ]"
        echo "basicConstraints = critical,CA:FALSE"
        echo "keyUsage = critical,digitalSignature"
        echo "extendedKeyUsage = clientAuth"
        echo "subjectKeyIdentifier = hash"
        echo "authorityKeyIdentifier = keyid"
    } > "$tmpext"
    # Clear any earlier output, so a failure here never leaves an old
    # certificate for the caller to collect. unlink removes a link, not its
    # target, so this is safe in staging.
    rm -f "$out" "$chainout"
    serial=$(random_serial) || exit 1
    # One year. The agent renews over its own mTLS session well before then;
    # a shorter life bounds what a copied key is worth.
    if ! sslerr=$(openssl x509 -req -in "$csrin" -CA "$cacert" -CAkey "$cakey" \
            -set_serial "$serial" -sha256 -days 365 \
            -extensions v3_agent -extfile "$tmpext" \
            -subj "/CN=fog-agent host ${hostid}/O=FOG Project/OU=FOG Agent" \
            -out "$leaf" 2>&1); then
        sign_failed "$sslerr"
    fi
    # What the agent presents beneath its leaf: the intermediate. The root
    # is what the server's vhost trusts and need not travel.
    cat "$cacert" > "$chain"
    anchor="${PKI_ROOT_CERT:-}"
    [[ -n $anchor && -f $anchor ]] || anchor="$cacert"
    if ! openssl verify -purpose sslclient -CAfile "$anchor" -untrusted "$cacert" "$leaf" >/dev/null 2>&1; then
        die "the issued certificate does not verify against ${anchor}"
    fi
    publish
    echo "OK"
    exit 0
fi

take san || die "no name list at ${san}"
sanin="${work}/in.san"

# anchor: what the issued certificate must verify against, and what the node is
# handed so it can serve a usable chain. Per zone, because the two zones are not
# anchored by the same thing.
#
# The web zone's anchor is NOT necessarily PKI_ROOT_CERT. When the admin brought
# their own Web CA, PKI_WEB_CA_CERT is their intermediate and the FOG root never
# signed it -- so verifying against the FOG root cannot build a chain, and
# appending the FOG root to what the node serves adds an unrelated certificate.
# PKI_WEB_ANCHOR is the web zone's own trust anchor
# (pki/web/ca/.trustAnchor.pem), which _resolveTrustAnchor builds with the FOG
# root AND an external root where there is one, deduped by fingerprint. That
# covers both installs with no branch here.
case "$type" in
    web)
        cacert="${PKI_WEB_CA_CERT:-}"
        cakey="${PKI_WEB_CA_KEY:-}"
        anchor="${PKI_WEB_ANCHOR:-${PKI_ROOT_CERT:-}}"
        # What the node serves beneath its leaf. PKI_WEB_CHAIN is the web zone's
        # trust path -- the issuing intermediate plus the root that anchors it --
        # so it is right for a FOG-issued and an imported CA alike. Falling back
        # to building it here keeps an older config working.
        chainsrc="${PKI_WEB_CHAIN:-}"
        eku="serverAuth"
        days=825
        ;;
    signing)
        cacert="${PKI_SB_CA_CERT:-}"
        cakey="${PKI_SB_CA_KEY:-}"
        # The Secure Boot intermediate is always minted under the FOG root --
        # there is no "bring your own Secure Boot root", because firmware trusts
        # the enrolled certificate directly and nothing above it is consulted.
        anchor="${PKI_ROOT_CERT:-}"
        chainsrc=""
        eku="codeSigning"
        days=730
        ;;
esac

if [[ -z $cacert || ! -f $cacert ]]; then
    die "the ${type} CA is not present on this server"
fi
if [[ -z $cakey || ! -f $cakey ]]; then
    # The expected state for the Secure Boot CA once its key has been vaulted.
    # Say which key and where, because the fix is to bring it back for one run.
    die "the ${type} CA private key is not on this server (expected at ${cakey:-<unset>}); restore it, issue the node certificates, then move it back"
fi

# Re-validate the names. Only two forms are ever legitimate here, and anything
# else is either a mistake or an attempt to smuggle openssl config syntax
# through a value -- a line containing '[' or '=' would open a new section in
# the extension file built below.
#
# A refusal names the line number, never the line. If the name list is a hard
# link to a root-only file (possible where fs.protected_hardlinks is off),
# printing the line would hand that file's contents to the web user.
sanlist=""
n_ip=0
n_dns=0
lineno=0
while IFS= read -r line; do
    lineno=$((lineno + 1))
    line="${line%$'\r'}"
    [[ -z $line ]] && continue
    case "$line" in
        IP:*)
            [[ ${line#IP:} =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || die "invalid IP entry on line ${lineno} of the name list"
            n_ip=$((n_ip + 1))
            sanlist="${sanlist}${sanlist:+,}IP.${n_ip}:${line#IP:}"
            ;;
        DNS:*)
            [[ ${line#DNS:} =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*$ ]] \
                || die "invalid DNS entry on line ${lineno} of the name list"
            n_dns=$((n_dns + 1))
            sanlist="${sanlist}${sanlist:+,}DNS.${n_dns}:${line#DNS:}"
            ;;
        *)
            die "unrecognised name entry on line ${lineno} of the name list"
            ;;
    esac
done < "$sanin"
[[ -n $sanlist ]] || die "no names to issue for"

# A DNS name is always required, for the same reason the Secure Boot signing
# leaf carries one: with DNS name constraints on the issuing CA and no dNSName
# SAN on the certificate, OpenSSL falls back to checking the subject CN against
# those constraints, and a node's CN is whatever the endpoint put there.
[[ $n_dns -gt 0 ]] || die "at least one DNS name is required"

tmpext="${work}/ext.cnf"
{
    echo "[ v3_node ]"
    echo "basicConstraints = critical,CA:FALSE"
    echo "extendedKeyUsage = ${eku}"
    echo "subjectKeyIdentifier = hash"
    echo "subjectAltName = @alt"
    echo "[ alt ]"
    # Re-emitted from the validated pieces rather than passed through, so the
    # bytes openssl reads are ones this script constructed.
    IFS=',' read -ra entries <<< "$sanlist"
    for e in "${entries[@]}"; do
        echo "${e%%:*} = ${e#*:}"
    done
} > "$tmpext"

# The subject is the master's own validated record of this node, not the
# CSR's -- openssl x509 -req otherwise keeps whatever subject the node put
# on its own CSR, which is a formality the node fills in without the master
# ever checking it (see the comment on the node side, in _requestNodeCert).
firstdns=""
for e in "${entries[@]}"; do
    [[ $e == DNS.* ]] && { firstdns="${e#*:}"; break; }
done

# Clear any earlier output: see the agent path.
rm -f "$out" "$chainout"
serial=$(random_serial) || exit 1
if ! sslerr=$(openssl x509 -req -in "$csrin" -CA "$cacert" -CAkey "$cakey" \
        -set_serial "$serial" -sha256 -days "$days" \
        -extensions v3_node -extfile "$tmpext" \
        -subj "/CN=${firstdns}/O=FOG Project/OU=FOG Web UI" \
        -out "$leaf" 2>&1); then
    sign_failed "$sslerr"
fi

# The node needs the issuer to serve a usable chain, and the anchor to know
# what it is trusting. Both are public.
#
# Prefer the zone's own maintained chain: it already IS issuer-plus-its-root,
# which is what an imported CA needs and what building it from PKI_ROOT_CERT got
# wrong. Without a chain configured, fall back to the issuer plus the anchor.
if [[ -n $chainsrc && -s $chainsrc ]]; then
    cat "$chainsrc" > "$chain"
else
    cat "$cacert" > "$chain"
    [[ -n $anchor && -f $anchor ]] && cat "$anchor" >> "$chain"
fi

# Verify before handing it back. A certificate that does not chain is the
# failure mode name constraints produce, and catching it here means the node
# is told rather than silently installing something no client accepts.
#
# Against $anchor, not PKI_ROOT_CERT. On an external-CA install the FOG root did
# not sign this issuer, so anchoring there failed for every node -- and failed
# with the message below, which sent the admin looking at name constraints for
# something that was never a name problem.
# Narrowing fallbacks, most correct first. A missing .trustAnchor.pem means an
# install that has not run _resolveTrustAnchor yet; the FOG root is still right
# on an ordinary install, and the issuer itself is the last resort that at least
# proves this helper signed what it thinks it signed.
if [[ -z $anchor || ! -f $anchor ]]; then
    anchor="${PKI_ROOT_CERT:-}"
fi
if [[ -z $anchor || ! -f $anchor ]]; then
    anchor="$cacert"
fi
if ! openssl verify -CAfile "$anchor" -untrusted "$cacert" "$leaf" >/dev/null 2>&1; then
    die "the issued certificate does not verify against ${anchor} -- a requested name is probably outside the CA's name constraints"
fi

publish
echo "OK"
