msgid "%d snapin"
msgid_plural "%d snapins"
msgstr[0] "%d 件のスナップイン"

#, php-format
msgid "%d token(s) disabled."
msgstr "%d 件のトークンを無効にしました。"

#, php-format
msgid "%d token(s) enabled."
msgstr "%d 件のトークンを有効にしました。"

#, php-format
msgid "%d token(s) revoked."
msgstr "%d 件のトークンを失効させました。"

#, php-format
msgid "%s %s log (%s)"
msgstr "%s %s ログ（%s）"

#, php-format
msgid "%s Manager"
msgstr "%s 管理"

#, php-format
msgid "%s Menu"
msgstr "%s メニュー"

#, php-format
msgid "%s added. Install it to set up its database."
msgstr "%s を追加しました。データベースを設定するにはインストールしてください。"

#, php-format
msgid "%s already has a token called \"%s\". Names have to be unique per user so a token can be told apart from its neighbors when it comes time to revoke one."
msgstr "%s には既に「%s」という名前のトークンがあります。トークンを失効させる際に区別できるよう、トークン名はユーザーごとに一意である必要があります。"

#, php-format
msgid "%s can only be run on one host at a time"
msgstr "%s は一度に 1 台のホストでしか実行できません"

#, php-format
msgid "%s cannot be used as %s."
msgstr "%s は %s として使用できません。"

#, php-format
msgid "%s could not be loaded. Check that %s declares a class of that exact name."
msgstr "%s を読み込めませんでした。%s に同じ名前のクラスが宣言されていることを確認してください。"

#, php-format
msgid "%s could not be removed."
msgstr "%s を削除できませんでした。"

#, php-format
msgid "%s deleted."
msgstr "%s を削除しました。"

#, php-format
msgid "%s does not declare schema() migrations, so re-installing it would drop and recreate its tables. Uninstall it first if that is what you want."
msgstr "%s には schema() によるマイグレーション定義がないため、再インストールするとテーブルが削除され、再作成されます。それを意図している場合は、先にアンインストールしてください。"

#, php-format
msgid "%s does not exist. Re-run the FOG installer."
msgstr "%s が存在しません。FOG インストーラーを再実行してください。"

#, php-format
msgid "%s images"
msgstr "%s 件のイメージ"

#, php-format
msgid "%s is in use as %s. Point that at another file first."
msgstr "%s は %s として使用中です。先に参照先を別のファイルへ変更してください。"

#, php-format
msgid "%s is maintained by the server and cannot be set"
msgstr "%s はサーバーによって管理されるため、設定できません"

#, php-format
msgid "%s is marked to be kept. Stop keeping it first."
msgstr "%s は保持対象として指定されています。先に保持設定を解除してください。"

#, php-format
msgid "%s is no longer kept."
msgstr "%s の保持設定を解除しました。"

#, php-format
msgid "%s is not a readable .tar.gz archive."
msgstr "%s は読み取り可能な .tar.gz アーカイブではありません。"

#, php-format
msgid "%s is not a usable plugin name. Use lowercase letters, digits, - and _."
msgstr "%s は使用できないプラグイン名です。小文字の英字、数字、-、_ を使用してください。"

#, php-format
msgid "%s is not inside a plugin directory."
msgstr "%s はプラグインディレクトリ内にありません。"

#, php-format
msgid "%s is not writable by the web server. Run \"bin/fog-plugin-uploads.sh enable\" as root."
msgstr "%s に Web サーバーから書き込めません。root 権限で「bin/fog-plugin-uploads.sh enable」を実行してください。"

#, php-format
msgid "%s is now %s."
msgstr "%s は %s になりました。"

#, php-format
msgid "%s is required"
msgstr "%s は必須です"

#, php-format
msgid "%s needs more than one host"
msgstr "%s には複数のホストが必要です"

#, php-format
msgid "%s replaced. Install it to apply any new database steps."
msgstr "%s を置き換えました。新しいデータベース更新を適用するにはインストールしてください。"

#, php-format
msgid "%s ships with FOG and cannot be replaced by an upload."
msgstr "%s は FOG に同梱されているため、アップロードによって置き換えることはできません。"

#, php-format
msgid "%s signs in through %s, so a password stored here would never be accepted. Clear the authentication source first."
msgstr "%s は %s 経由でログインするため、ここに保存したパスワードは認証に使用されません。先に認証元の設定を解除してください。"

#, php-format
msgid "%s value \"%s\" did not match any %s by id or name; left unset"
msgstr "%s の値「%s」に一致する %s が ID または名前で見つからなかったため、未設定のままにしました"

#, php-format
msgid "%s viewed your account on %s."
msgstr "%s が %s にあなたのアカウントを閲覧しました。"

#, php-format
msgid "%s will be kept."
msgstr "%s を保持します。"

msgid "(all)"
msgstr "（すべて）"

#, php-format
msgid "(deleted host %d)"
msgstr "（削除済みホスト %d）"

msgid "(deleted user)"
msgstr "（削除済みユーザー）"

msgid "(empty on all)"
msgstr "（すべて空欄）"

msgid "(none)"
msgstr "（なし）"

msgid "(set on all)"
msgstr "（すべて設定済み）"

msgid "(varies)"
msgstr "（項目によって異なる）"

#, php-format
msgid ", Arguments = %s"
msgstr "、引数 = %s"

msgid "0 checks only when the assigned set changes"
msgstr "0 を指定すると、割り当てられたセットが変更された場合にのみ確認します"

msgid "0 is a normal snapin, 1 a snapin pack the client extracts before running."
msgstr "0 は通常のスナップイン、1 は実行前にクライアントが展開するスナップインパックを表します。"

msgid "0 logs the user out with no warning"
msgstr "0 を指定すると、警告なしでユーザーをログアウトさせます"

msgid "1 Hour"
msgstr "1時間"

msgid "1 Year"
msgstr "1年"

msgid "1. A certificate already on this server"
msgstr "1. このサーバーに既にある証明書"

msgid "10"
msgstr "10"

msgid "10 Minutes"
msgstr "10分"

msgid "100"
msgstr "100"

msgid "192.168.1.0/24, 10.1.0.0/16"
msgstr "192.168.1.0/24, 10.1.0.0/16"

msgid "192.168.1.252 or printer.example.com:9100"
msgstr "192.168.1.252 または printer.example.com:9100"

msgid "2 Minutes"
msgstr "2分"

msgid "2. A certificate signing request"
msgstr "2. 証明書署名要求（CSR）"

msgid "25"
msgstr "25"

msgid "3. Upload a certificate and its key"
msgstr "3. 証明書と秘密鍵をアップロード"

msgid "30 Days"
msgstr "30日"

msgid "30 Minutes"
msgstr "30分"

msgid "31 to 90 days"
msgstr "31～90日"

msgid "5 Minutes"
msgstr "5分"

msgid "50"
msgstr "50"

msgid "6 Months"
msgstr "6か月"

msgid "60 Days"
msgstr "60日"

msgid "90 Days"
msgstr "90日"

msgid "91 to 365 days"
msgstr "91～365日"

msgid "A .tar.gz holding one directory named for the plugin, with config/plugin.config.php inside it."
msgstr "プラグイン名と同じ名前のディレクトリが 1 つ含まれ、その中に config/plugin.config.php がある .tar.gz アーカイブ。"

msgid "A CA certificate is refused. Replacing FOG's own root is a migration rather than a setting -- see the Using your own PKI tab."
msgstr "CA 証明書は受け付けられません。FOG 自身のルート証明書の置き換えは、単なる設定変更ではなく移行作業です。「独自 PKI の使用」タブを参照してください。"

msgid "A FOG username and password."
msgstr "FOG のユーザー名とパスワード。"

msgid "A LDAP setup already exists with this name!"
msgstr "この名前の LDAP 設定は既に存在します！"

msgid "A PEM certificate with its key, or one PKCS#12 (.p12/.pfx) file carrying both. A full chain is fine -- put the leaf first -- and the intermediates are separated out for you."
msgstr "PEM 形式の証明書とその秘密鍵、または両方を含む 1 つの PKCS#12（.p12/.pfx）ファイル。証明書チェーン全体を指定する場合は、リーフ証明書を先頭にしてください。中間証明書は自動的に分離されます。"

msgid "A TCP/IP port printer requires an IP address or hostname."
msgstr "TCP/IP ポートプリンターには IP アドレスまたはホスト名が必要です。"

msgid "A Windows Key already exists with this name!"
msgstr "この名前の Windows キーは既に存在します！"

msgid "A Windows Key already exists with this product key!"
msgstr "このプロダクトキーを持つ Windows キーは既に存在します！"

msgid "A broadcast already exists with this name!"
msgstr "この名前のブロードキャストは既に存在します！"

msgid "A client ID is required"
msgstr "クライアント ID は必須です"

msgid "A denied agent keeps asking and keeps being refused until it is enrolled with a new key."
msgstr "拒否されたエージェントは、新しいキーで登録されるまで要求を繰り返し、その都度拒否されます。"

msgid "A disabled entry stops being managed; it does not remove the package."
msgstr "無効にした項目は管理対象から外れますが、パッケージ自体は削除されません。"

msgid "A dmi field must be set!"
msgstr "DMI フィールドを設定する必要があります！"

msgid "A domain already exists with this name!"
msgstr "この名前のドメインは既に存在します！"

msgid "A file"
msgstr "ファイル"

msgid "A file must be uploaded via the \"snapinfile\" multipart field"
msgstr "「snapinfile」マルチパートフィールドを使用してファイルをアップロードする必要があります"

msgid "A filename is required!"
msgstr "ファイル名は必須です！"

msgid "A filter needs a grid and a name"
msgstr "フィルターにはグリッドと名前が必要です"

msgid "A filter needs a name"
msgstr "フィルターには名前が必要です"

msgid "A group already exists with this name!"
msgstr "この名前のグループは既に存在します！"

msgid "A group must be selected."
msgstr "グループを選択してください。"

msgid "A group name is required!"
msgstr "グループ名は必須です！"

msgid "A hook is not an event listener"
msgstr "フックはイベントリスナーではありません"

msgid "A host already exists with this name!"
msgstr "この名前のホストは既に存在します！"

msgid "A host imaged inside this range counts as current. Everything else is measured back from the end date."
msgstr "指定期間内にイメージ処理されたホストは現在のものとして扱われます。それ以外は終了日を基準に遡って判定されます。"

msgid "A host with that name already exists"
msgstr "その名前のホストは既に存在します"

msgid "A host with this mac already exists with name"
msgstr "この MAC アドレスを持つホストは既に存在します"

msgid "A location already exists with this name!"
msgstr "この名前のロケーションは既に存在します！"

msgid "A menu entry already exists with this name!"
msgstr "この名前のメニュー項目は既に存在します！"

msgid "A migration step failed. The plugin is left activated and not marked installed."
msgstr "マイグレーション処理に失敗しました。プラグインは有効化されたままですが、インストール済みにはなっていません。"

msgid "A missing name, a bad use count, or an expiry that is not in the future."
msgstr "名前が未入力、使用回数が無効、または有効期限が未来の日付になっていません。"

msgid "A module already exists with this name!"
msgstr "この名前のモジュールは既に存在します！"

msgid "A module granted here is on for every host in this group, including hosts added later -- unless the host itself says otherwise. A host set to Off on its own Modules tab stays off, and no grant can override that."
msgstr "ここで許可したモジュールは、後から追加されたホストを含め、このグループ内のすべてのホストで有効になります。ただし、ホスト側で別の設定がある場合はそちらが優先されます。ホスト自身の「モジュール」タブでオフに設定したモジュールは無効のままとなり、グループからの許可では上書きできません。"

msgid "A name must be defined if using the \"name\" property"
msgstr "\"name\" プロパティを使用する場合は、名前を定義する必要があります"

msgid "A name that is not already a group is created when you add. Remove only works on groups that exist."
msgstr "指定した名前のグループがまだ存在しない場合は、追加時に作成されます。削除できるのは既存のグループだけです。"

msgid "A page of results."
msgstr "結果の 1 ページ分。"

msgid "A permission name is required."
msgstr "権限名は必須です。"

msgid "A pinned entry needs a version."
msgstr "固定した項目にはバージョンの指定が必要です。"

msgid "A plugin is PHP that runs on this server. Only upload one you trust. Nothing is installed until you have seen what the archive contains and confirmed it."
msgstr "プラグインは、このサーバー上で実行される PHP コードです。信頼できるものだけをアップロードしてください。アーカイブの内容を確認して承認するまで、インストールは行われません。"

msgid "A port must be specified"
msgstr "ポートの指定は必須です"

msgid "A printer already exists with this name!"
msgstr "この名前のプリンターは既に存在します！"

msgid "A printer granted here reaches every host in this group, including hosts added later. Removing a host from the group takes the printer away again. A printer the host was given directly is unaffected either way."
msgstr "ここで割り当てたプリンターは、後から追加されたホストも含め、このグループ内のすべてのホストに適用されます。ホストをグループから削除すると、そのプリンターの割り当ても解除されます。ただし、ホストに直接割り当てたプリンターは、グループへの追加や削除の影響を受けません。"

msgid "A provider already exists with this name!"
msgstr "この名前のプロバイダーは既に存在します！"

#, php-format
msgid "A request is pending since %s for %s."
msgstr "%s 以降、%s に対する要求が保留中です。"

msgid "A revoked token can never approve an enrollment again."
msgstr "失効したトークンでは、再びエージェントの登録を承認することはできません。"

msgid "A role already exists with this name!"
msgstr "この名前のロールは既に存在します！"

msgid "A role with this name already exists!"
msgstr "この名前のロールは既に存在します！"

msgid "A root CA uploaded on this page. Absent unless one was imported."
msgstr "このページからアップロードされたルート CA 証明書。インポートされていない場合は存在しません。"

#, php-format
msgid "A root was supplied alongside it (%s). FOG does not trust a root just because it arrived beside a certificate -- import it deliberately on the External root CA tab, then adopt."
msgstr "証明書とともにルート証明書（%s）が提供されました。FOG は、証明書に同梱されているというだけではルート証明書を信頼しません。「外部ルート CA」タブで明示的にインポートしてから、採用処理を行ってください。"

msgid "A scheduled time is required"
msgstr "スケジュール時刻は必須です"

msgid "A selected role no longer exists"
msgstr "選択したロールは既に存在しません"

msgid "A server URL and topic endpoint are required"
msgstr "サーバー URL とトピックエンドポイントは必須です"

#, php-format
msgid "A signing request for %s is ready to download. Have your CA sign it, then upload the certificate here."
msgstr "%s の証明書署名要求をダウンロードできます。CA で署名してから、ここに証明書をアップロードしてください。"

msgid "A site already exists with this name!"
msgstr "この名前のサイトは既に存在します！"

msgid "A snapin already exists with this name!"
msgstr "この名前のスナップインは既に存在します！"

msgid "A snapin granted here reaches every host in this group, including hosts added later. Granting a snapin does not run it; deploy it from the Tasks tab when you want it to run."
msgstr "ここで割り当てたスナップインは、後から追加されたホストも含め、このグループ内のすべてのホストに適用されます。割り当てただけでは実行されません。実行する場合は「タスク」タブから展開してください。"

msgid "A software entry already exists with this name!"
msgstr "この名前のソフトウェア項目は既に存在します！"

msgid "A storage group already exists with this name!"
msgstr "この名前のストレージグループは既に存在します！"

msgid "A storage group exists with this name!"
msgstr "この名前のストレージグループは既に存在します！"

msgid "A storage group must be selected."
msgstr "ストレージグループを選択してください。"

msgid "A storage node already exists with this name!"
msgstr "この名前のストレージノードは既に存在します！"

msgid "A storage node always belongs to exactly one storage group. Adding a node here MOVES it into this group from wherever it is now; a group with no nodes left is fine. To take a node out of this group, add it to the group it should be in instead."
msgstr "ストレージノードは必ず 1 つのストレージグループに所属します。ここでノードを追加すると、現在所属しているグループからこのグループへ移動します。移動元のグループにノードがなくなっても問題ありません。このグループからノードを外すには、移動先のグループにそのノードを追加してください。"

msgid "A storage node must belong to a storage group. Add it to the group you want it in instead; that moves it, and a group with no nodes left is fine."
msgstr "ストレージノードは必ずストレージグループに所属する必要があります。移動先のグループにノードを追加してください。ノードがなくなったグループがあっても問題ありません。"

msgid "A subnet group already exists with this name!"
msgstr "この名前のサブネットグループは既に存在します！"

msgid "A subnet group is already using this group."
msgstr "このグループは既にサブネットグループで使用されています。"

msgid "A task already exists for this host at the scheduled tasking"
msgstr "このホストには、同じスケジュール時刻のタスクが既に存在します"

msgid "A task state already exists with this name!"
msgstr "この名前のタスク状態は既に存在します！"

msgid "A task type already exists with this name!"
msgstr "この名前のタスクタイプは既に存在します！"

#, php-format
msgid "A usable pair is waiting: %s, valid until %s."
msgstr "使用可能なペアがあります: %s（有効期限: %s）。"

msgid "A user already exists with this name"
msgstr "この名前のユーザーは既に存在します"

msgid "A user can start a task only when one of their roles grants its type here, and the host, group or image Task permission on the Permissions tab."
