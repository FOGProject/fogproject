msgid " * File delete queue is globally disabled"
msgstr " * ファイル削除キューは全体設定で無効になっています"

msgid " * Image replication is globally disabled"
msgstr " * イメージレプリケーションは全体設定で無効になっています"

msgid " * Image size is globally disabled"
msgstr " * イメージサイズ機能は全体設定で無効になっています"

msgid " * Multicast service is globally disabled"
msgstr " * マルチキャストサービスは全体設定で無効になっています"

msgid " * Ping hosts is globally disabled"
msgstr " * ホストの Ping 機能は全体設定で無効になっています"

msgid " * Snapin hash is globally disabled"
msgstr " * スナップインハッシュ機能は全体設定で無効になっています"

msgid " * Snapin replication is globally disabled"
msgstr " * スナップインレプリケーションは全体設定で無効になっています"

msgid " * Task Scheduler is globally disabled"
msgstr " * タスクスケジューラは全体設定で無効になっています"

msgid " to login"
msgstr " ログインするには"

msgid " | This is not the master node"
msgstr " | これはマスターノードではありません"

msgid " | Unable to find image path"
msgstr " | イメージパスが見つかりません"

