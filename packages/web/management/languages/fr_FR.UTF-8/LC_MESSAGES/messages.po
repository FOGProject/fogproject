msgstr "Échec du déploiement de l'image %1$s sur cet hôte : %2$s"

msgid "This host follows the default printer level in FOG Configuration, FOG Client - Printer Manager. A change to the default reaches this host."
msgstr "Cet hôte utilise le niveau d'imprimante par défaut défini dans la configuration FOG (Gestionnaire d'imprimantes du client FOG). Toute modification apportée à ce niveau par défaut est répercutée sur cet hôte."

msgid "This host has already joined this multicast session, which is now under way. A host cannot rejoin a session in progress. Cancel the task and re-create it once the current session has finished."
msgstr "Cet hôte a déjà rejoint cette session multicast, qui est en cours. Il est impossible de rejoindre une session en cours. Annulez la tâche et recréez-la une fois la session actuelle terminée."

#, php-format
