#, php-format
msgid "?expand accepts: %1$s, or all. Each to-many token (%2$s) also adds <token>_total and <token>_truncated."
msgstr "?expand accepte : %1$s, ou all. Chaque jeton de relation un-à-plusieurs (%2$s) ajoute également <token>_total et <token>_truncated."

msgid "A .tar.gz holding one directory named for the plugin, with config/plugin.config.php inside it."
msgstr "Un fichier .tar.gz contenant un répertoire portant le nom du plugin, avec le fichier config/plugin.config.php à l'intérieur."

msgid "A CA certificate is refused. Replacing FOG's own root is a migration rather than a setting -- see the Using your own PKI tab."
msgstr "Le certificat d'autorité de certification est refusé. Le remplacement du certificat racine de FOG est une migration et non un paramètre ; consultez l'onglet « Utilisation de votre propre infrastructure à clés publiques »."

msgid "A FOG username and password."
msgstr "Un nom d'utilisateur et un mot de passe FOG."

msgid "A LDAP setup already exists with this name!"
msgstr "Une configuration LDAP existe déjà sous ce nom !"

msgid "A PEM certificate with its key, or one PKCS#12 (.p12/.pfx) file carrying both. A full chain is fine -- put the leaf first -- and the intermediates are separated out for you."
msgstr "Un certificat PEM avec sa clé, ou un fichier PKCS#12 (.p12/.pfx) contenant les deux. Une chaîne complète convient parfaitement ; placez le certificat principal en premier ; les certificats intermédiaires sont automatiquement séparés."

msgid "A TCP/IP port printer requires an IP address or hostname."
msgstr "Une imprimante à port TCP/IP nécessite une adresse IP ou un nom d'hôte."

msgid "A Windows Key already exists with this name!"
msgstr "Une clé Windows porte déjà ce nom !"

msgid "A Windows Key already exists with this product key!"
msgstr "Une clé Windows existe déjà avec cette clé de produit !"

msgid "A broadcast already exists with this name!"
msgstr "Une diffusion porte déjà ce nom !"

msgid "A client ID is required"
msgstr "Un identifiant client est requis."

msgid "A denied agent keeps asking and keeps being refused until it is enrolled with a new key."
msgstr "Un agent dont l'accès a été refusé continue de demander et de se voir refuser l'accès jusqu'à ce qu'il soit enregistré avec une nouvelle clé."

msgid "A directory rejoin result the server refuses. The reason codes include these: it names another attempt, revision, task or fingerprint than the stored plan (rejoin_result_mismatch), arrives out of order (rejoin_result_out_of_order), changed meanwhile (rejoin_result_changed), reports a native failure as success (rejoin_native_success_required), finds a different or unverifiable directory account (rejoin_target_changed, rename_identity_unverified, rename_target_unverified), or reports verified without a healthy secure channel, a changed boot, the planned name and the planned domain (rejoin_verification_incomplete). A directory outage or a lookup error (rejoin_directory_unavailable, rejoin_lookup_failed), a concurrent change (rejoin_plan_changed, rejoin_deadlock_retry) or an unreadable stored state (rejoin_state_invalid) is also a 409; retry later. Nothing is recorded."
msgstr "Le serveur refuse ce résultat de réintégration à l’annuaire. Les codes d’erreur possibles sont : tentative, révision, tâche ou empreinte différentes du plan enregistré (rejoin_result_mismatch) ; résultat reçu dans le désordre (rejoin_result_out_of_order) ou modifié entre-temps (rejoin_result_changed) ; échec natif présenté comme une réussite (rejoin_native_success_required) ; compte d’annuaire différent ou impossible à vérifier (rejoin_target_changed, rename_identity_unverified, rename_target_unverified) ; ou vérification déclarée réussie alors que le canal sécurisé, le redémarrage, le nom ou le domaine prévu n’est pas confirmé (rejoin_verification_incomplete). Une indisponibilité de l’annuaire ou une erreur de recherche (rejoin_directory_unavailable, rejoin_lookup_failed), une modification concurrente (rejoin_plan_changed, rejoin_deadlock_retry) ou un état enregistré illisible (rejoin_state_invalid) entraînent également une erreur HTTP 409 : réessayez plus tard. Aucune donnée n’est enregistrée."

msgid "A disabled entry stops being managed; it does not remove the package."
msgstr "Une entrée désactivée cesse d'être gérée ; cela ne supprime pas le paquet."

msgid "A dmi field must be set!"
msgstr "Un champ DMI doit être défini !"

msgid "A domain already exists with this name!"
msgstr "Un domaine existe déjà sous ce nom !"

msgid "A file"
msgstr "Un fichier"

msgid "A file must be uploaded via the \"snapinfile\" multipart field"
msgstr "Un fichier doit être téléversé via le champ multipart « snapinfile »."

msgid "A filename is required!"
msgstr "Un nom de fichier est requis !"

msgid "A filter needs a grid and a name"
msgstr "Un filtre doit comporter une grille et un nom."

msgid "A filter needs a name"
msgstr "Un filtre doit comporter un nom."

msgid "A group already exists with this name!"
msgstr "Un groupe porte déjà ce nom !"

msgid "A group must be selected."
msgstr "Un groupe doit être sélectionné."

msgid "A group name is required!"
msgstr "Un nom de groupe est requis !"

msgid "A hook is not an event listener"
msgstr "Un hook n'est pas un écouteur d'événements."

msgid "A host already exists with this name!"
msgstr "Un hôte existe déjà sous ce nom !"

msgid "A host imaged inside this range counts as current. Everything else is measured back from the end date."
msgstr "Un hôte ayant reçu une image pendant cette période est considéré comme à jour. Pour les autres, le délai est calculé à partir de la date de fin."

msgid "A host with agents on more than one OS runs this snapin only on the OS chosen here. Any runs it on all of them."
msgstr ""

msgid "A host with that name already exists"
msgstr "Un hôte portant ce nom existe déjà."

msgid "A host with this mac already exists with name"
msgstr "Un hôte avec cette adresse MAC existe déjà sous le nom"

msgid "A location already exists with this name!"
msgstr "Un lieu porte déjà ce nom !"

msgid "A menu entry already exists with this name!"
msgstr "Une entrée de menu existe déjà sous ce nom !"

msgid "A migration step failed. The plugin is left activated and not marked installed."
msgstr "Une étape de migration a échoué. Le plugin reste activé et n'est pas marqué comme installé."

msgid "A missing name, a bad use count, or an expiry that is not in the future."
msgstr "Un nom manquant, un nombre d'utilisations incorrect ou une date d'expiration qui n'est pas future."

msgid "A module already exists with this name!"
msgstr "Un module portant ce nom existe déjà !"

msgid "A module granted here is on for every host in this group, including hosts added later -- unless the host itself says otherwise. A host set to Off on its own Modules tab stays off, and no grant can override that."
msgstr "Un module autorisé ici est activé pour tous les hôtes de ce groupe, y compris ceux ajoutés ultérieurement, sauf indication contraire de l'hôte lui-même. Un hôte dont le module est désactivé dans son onglet Modules reste désactivé, et aucune autorisation ne peut modifier ce paramètre."

msgid "A name must be defined if using the \"name\" property"
msgstr "Un nom doit être défini si l'on utilise la propriété « name »."

msgid "A name that is not already a group is created when you add. Remove only works on groups that exist."
msgstr "Lors de l'ajout, un nom qui n'est pas encore associé à un groupe est créé. La suppression ne fonctionne que sur les groupes existants."

msgid "A page of results."
msgstr "Une page de résultats."

msgid "A permission name is required."
msgstr "Le nom de l'autorisation est obligatoire."

msgid "A pinned entry needs a version."
msgstr "Une entrée épinglée nécessite une version."

msgid "A plugin is PHP that runs on this server. Only upload one you trust. Nothing is installed until you have seen what the archive contains and confirmed it."
msgstr "Un plugin contient du code PHP exécuté sur ce serveur. Ne téléversez que des plugins de confiance. Rien ne sera installé avant que vous ayez examiné le contenu de l’archive et confirmé l’opération."

msgid "A port must be specified"
msgstr "Un port doit être spécifié"

msgid "A printer already exists with this name!"
msgstr "Une imprimante porte déjà ce nom !"

msgid "A printer granted here reaches every host in this group, including hosts added later. Removing a host from the group takes the printer away again. A printer the host was given directly is unaffected either way."
msgstr "Une imprimante attribuée ici l’est à tous les hôtes du groupe, y compris ceux ajoutés ultérieurement. Si un hôte quitte le groupe, cette attribution est retirée. Les imprimantes attribuées directement à l’hôte restent inchangées."

msgid "A provider already exists with this name!"
msgstr "Un fournisseur porte déjà ce nom !"

#, php-format
msgid "A request is pending since %s for %s."
msgstr "Une requête est en attente depuis %s pour %s."

#, php-format
msgid "A request to move this computer object to %s has an unknown result. Read the directory to see where the object is."
msgstr "La tentative de déplacement de cet objet ordinateur vers %s a abouti à un résultat inconnu. Consultez le répertoire pour localiser l'objet."

#, php-format
msgid "A request to move this computer object to %s may have run, or may still be running."
msgstr "Une requête visant à déplacer cet objet ordinateur vers %s a peut-être été exécutée, ou est peut-être encore en cours d'exécution."

msgid "A revoked token can never approve an enrollment again."
msgstr "Un jeton révoqué ne pourra plus jamais approuver une inscription."

msgid "A role already exists with this name!"
msgstr "Un rôle porte déjà ce nom !"

msgid "A role with this name already exists!"
msgstr "Un rôle portant ce nom existe déjà !"

msgid "A root CA uploaded on this page. Absent unless one was imported."
msgstr "Une autorité de certification racine téléversée sur cette page. Absente tant qu'aucune n'a été importée."

#, php-format
msgid "A root was supplied alongside it (%s). FOG does not trust a root just because it arrived beside a certificate -- import it deliberately on the External root CA tab, then adopt."
msgstr "Une autorité de certification racine a été fournie en même temps (%s). FOG ne fait pas confiance à une autorité de certification racine simplement parce qu'elle est fournie avec un certificat ; importez-la manuellement dans l'onglet « Autorité de certification racine externe », puis adoptez-la."

msgid "A scheduled time is required"
msgstr "Un horaire précis est requis."

msgid "A selected role no longer exists"
msgstr "Le rôle sélectionné n'existe plus."

msgid "A server URL and topic endpoint are required"
msgstr "Une URL de serveur et un point de terminaison de sujet sont requis."

#, php-format
msgid "A signing request for %s is ready to download. Have your CA sign it, then upload the certificate here."
msgstr "Une demande de signature de certificat pour %s est prête à être téléchargée. Faites-la signer par votre autorité de certification, puis téléversez ici le certificat signé."

msgid "A site already exists with this name!"
msgstr "Un site porte déjà ce nom !"

msgid "A snapin already exists with this name!"
msgstr "Un snapin porte déjà ce nom !"

msgid "A snapin granted here reaches every host in this group, including hosts added later. Granting a snapin does not run it; deploy it from the Tasks tab when you want it to run."
msgstr "Un snapin attribué ici l’est à tous les hôtes du groupe, y compris ceux ajoutés ultérieurement. Cette attribution ne l’exécute pas : lancez son déploiement depuis l’onglet Tâches."

msgid "A software entry already exists with this name!"
msgstr "Une entrée logicielle existe déjà sous ce nom !"

msgid "A storage group already exists with this name!"
msgstr "Un groupe de stockage porte déjà ce nom !"

msgid "A storage group exists with this name!"
msgstr "Un groupe de stockage porte ce nom !"

msgid "A storage group must be selected."
msgstr "Un groupe de stockage doit être sélectionné."

msgid "A storage node already exists with this name!"
msgstr "Un nœud de stockage existe déjà sous ce nom !"

msgid "A storage node always belongs to exactly one storage group. Adding a node here MOVES it into this group from wherever it is now; a group with no nodes left is fine. To take a node out of this group, add it to the group it should be in instead."
msgstr "Un nœud de stockage appartient toujours à un seul groupe de stockage. Ajouter un nœud ici le déplace vers ce groupe depuis son emplacement actuel ; un groupe vide convient. Pour retirer un nœud de ce groupe, ajoutez-le au groupe auquel il devrait appartenir."

msgid "A storage node must belong to a storage group. Add it to the group you want it in instead; that moves it, and a group with no nodes left is fine."
msgstr "Un nœud de stockage doit appartenir à un groupe de stockage. Ajoutez-le plutôt au groupe souhaité ; cela le déplacera, et un groupe sans nœuds restants convient parfaitement."

msgid "A subnet group already exists with this name!"
msgstr "Un groupe de sous-réseaux porte déjà ce nom !"

msgid "A subnet group is already using this group."
msgstr "Un groupe de sous-réseaux utilise déjà ce groupe."

msgid "A task already exists for this host at the scheduled tasking"
msgstr "Une tâche est déjà planifiée pour cet hôte à cette date."

msgid "A task state already exists with this name!"
msgstr "Un état de tâche existe déjà sous ce nom !"

msgid "A task type already exists with this name!"
msgstr "Un type de tâche porte déjà ce nom !"

msgid "A tooltip for the web UI. Always \"\" on an API request; ignore it."
msgstr "Une infobulle destinée à l'interface web. Toujours vide dans une requête API ; à ignorer."

#, php-format
msgid "A usable pair is waiting: %s, valid until %s."
msgstr "Une paire utilisable est en attente : %s, valable jusqu'au %s."

msgid "A user already exists with this name"
