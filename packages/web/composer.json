{
    "name": "fogproject/fogproject",
    "description": "FOG Project - free open-source network computer cloning and management",
    "type": "project",
    "version": "1.6.0",
    "license": "GPL-3.0-only",
    "homepage": "https://fogproject.org",
    "support": {
        "issues": "https://github.com/FOGProject/fogproject/issues",
        "forum": "https://forums.fogproject.org"
    },
    "require": {
        "php": ">=7.4",
        "firebase/php-jwt": "^6.10",
        "ifsnop/mysqldump-php": "^2.13"
    },
    "autoload": {
        "psr-4": {
            "FOG\\": [
                "src/",
                "src/Items/",
                "src/Managers/",
                "src/Base/",
                "src/Service/",
                "src/Client/",
                "src/Net/",
                "src/Db/",
                "src/Auth/",
                "src/Audit/",
                "src/TaskHandling/",
                "src/Boot/",
                "src/Router/",
                "src/Util/",
                "src/Exception/"
            ]
        }
    },
    "config": {
        "platform": {
            "php": "7.4.0"
        },
        "platform-check": false,
        "optimize-autoloader": true,
        "sort-packages": true,
        "policy": {
            "advisories": {
                "ignore-id": [
                    "PKSA-y2cr-5h3j-g3ys"
                ]
            }
        }
    }
}
