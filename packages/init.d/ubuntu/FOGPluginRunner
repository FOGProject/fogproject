#!/bin/sh
### BEGIN INIT INFO
# Provides: FOGPluginRunner
# Required-Start: $local_fs $remote_fs $network $syslog $network $inetd $apache2 $mysql
# Required-Stop: $local_fs $remote_fs $network $syslog $network $inetd
# Default-Start: 2 3 4 5
# Default-Stop: 0 1 6
# X-Interactive: true
# Short-Description: Start/Stop FOGPluginRunner
# Long-Description: Runs background work declared by installed, active plugins.
# FOGPluginRunner is the single daemon behind every plugin's scheduled tasks,
# so that a plugin never has to ship a systemd unit of its own.
### END INIT INFO

PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/bin:/usr/sbin
DAEMON=/opt/fog/service/FOGPluginRunner/FOGPluginRunner
NAME=FOGPluginRunner
PIDFILE=/var/run/fog/$NAME.pid
DESC="FOG Computer Imaging Solution"
# ADR 0010: this daemon runs as the web user, not root, because it executes
# third-party plugin code. FOGWEBUSER is rewritten to $apacheuser in the
# installed copy by installInitScript(); the init script itself still runs as
# root so it can create the pid directory.
RUNASUSER=FOGWEBUSER

test -f $DAEMON || exit 1

. /lib/lsb/init-functions

case "$1" in
	start)
		log_begin_msg "Starting $DESC: $NAME"
		mkdir -p `dirname "$PIDFILE"`
		if [ ! -f "$PIDFILE" ]; then
			start-stop-daemon --start --quiet --chuid "$RUNASUSER" --pidfile "$PIDFILE" --make-pidfile -b --exec "$DAEMON"
			log_end_msg $?
		else
			log_end_msg 1;
		fi
		;;
	stop)
		log_begin_msg "Stopping $DESC: $NAME"
		start-stop-daemon --stop --quiet --retry 5 --oknodo --pidfile "$PIDFILE" && success=1
		rm "$PIDFILE" 2>/dev/null >/dev/null
		killall $DAEMON 2>/dev/null >/dev/null
		log_end_msg 0
		;;
	restart)
		log_begin_msg "Restarting $DESC: $NAME"
		start-stop-daemon --stop --quiet --retry 5 --oknodo --pidfile "$PIDFILE" && success=1
		rm "$PIDFILE" 2>/dev/null >/dev/null
		killall $DAEMON 2>/dev/null >/dev/null
		mkdir -p `dirname "$PIDFILE"`
		if [ ! -f "$PIDFILE" ]; then
			start-stop-daemon --start --quiet --chuid "$RUNASUSER" --pidfile "$PIDFILE" --make-pidfile -b --exec "$DAEMON"
			log_end_msg $?
		else
			log_end_msg 1;
		fi
		;;
	status)
		status_of_proc ${DAEMON} ${NAME}
		;;
	*)
		echo "Usage FOGPluginRunner {start|stop|restart|status}" >&2
		exit 1;
		;;
esac

exit 0;
