#!/bin/sh
### BEGIN INIT INFO
# Provides: FOGRetentionRunner
# Required-Start: $local_fs $remote_fs $network $syslog $network $inetd $apache2 $mysql
# Required-Stop: $local_fs $remote_fs $network $syslog $network $inetd
# Default-Start: 2 3 4 5
# Default-Stop: 0 1 6
# X-Interactive: true
# Short-Description: Start/Stop FOGRetentionRunner
# Long-Description: Ages out the tables that record what happened -- the audit
# trail, the administrative history, the host login records and the task log.
# Stopping or disabling this script stops that pruning; nothing else does it.
### END INIT INFO

PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/bin:/usr/sbin
DAEMON=/opt/fog/service/FOGRetentionRunner/FOGRetentionRunner
NAME=FOGRetentionRunner
PIDFILE=/var/run/fog/$NAME.pid
DESC="FOG Computer Imaging Solution"
# Like FOGPluginRunner, this daemon runs as the web user rather than root: it
# needs a database connection and nothing else. FOGWEBUSER is rewritten to
# $apacheuser in the installed copy by installInitScript(); the init script
# itself still runs as root so it can create the pid directory.
RUNASUSER=FOGWEBUSER

test -f $DAEMON || exit 1

. /lib/lsb/init-functions

case "$1" in
	start)
		log_begin_msg "Starting $DESC: $NAME"
		mkdir -p `dirname "$PIDFILE"`
		if [ ! -f "$PIDFILE" ]; then
			start-stop-daemon --start --quiet --chuid "$RUNASUSER" --pidfile "$PIDFILE" --make-pidfile -b --exec "$DAEMON"
			log_end_msg $?
		else
			log_end_msg 1;
		fi
		;;
	stop)
		log_begin_msg "Stopping $DESC: $NAME"
		start-stop-daemon --stop --quiet --retry 5 --oknodo --pidfile "$PIDFILE" && success=1
		rm "$PIDFILE" 2>/dev/null >/dev/null
		killall $DAEMON 2>/dev/null >/dev/null
		log_end_msg 0
		;;
	restart)
		log_begin_msg "Restarting $DESC: $NAME"
		start-stop-daemon --stop --quiet --retry 5 --oknodo --pidfile "$PIDFILE" && success=1
		rm "$PIDFILE" 2>/dev/null >/dev/null
		killall $DAEMON 2>/dev/null >/dev/null
		mkdir -p `dirname "$PIDFILE"`
		if [ ! -f "$PIDFILE" ]; then
			start-stop-daemon --start --quiet --chuid "$RUNASUSER" --pidfile "$PIDFILE" --make-pidfile -b --exec "$DAEMON"
			log_end_msg $?
		else
			log_end_msg 1;
		fi
		;;
	status)
		status_of_proc ${DAEMON} ${NAME}
		;;
	*)
		echo "Usage FOGRetentionRunner {start|stop|restart|status}" >&2
		exit 1;
		;;
esac

exit 0;
