#!/bin/sh
#   chkconfig: 2345 95 13
#   description: Startup/shutdown script for the FOG Retention Runner \
#                service.

# Source function library.
. /etc/init.d/functions

# Like FOGPluginRunner, this daemon runs as the web user rather than root: it
# needs a database connection and nothing else. FOGWEBUSER is rewritten to
# $apacheuser in the installed copy by installInitScript(); the init script
# itself still runs as root so it can write the lock file.
RUNASUSER=FOGWEBUSER

DAEMONSTART="/opt/fog/service/FOGRetentionRunner/FOGRetentionRunner &"
DAEMONKILL=FOGRetentionRunner

prog=FOGRetentionRunner

start () {
	echo -n $"Starting $prog: "

	# start daemon
	daemon --user=$RUNASUSER $DAEMONSTART
        RETVAL=$?
	echo
	[ $RETVAL = 0 ] && touch /var/lock/subsys/fogretentionrunner
	return $RETVAL
}

stop () {
	# stop daemon
	echo -n $"Stopping $prog: "
	killproc $DAEMONKILL
	RETVAL=$?
	echo
	[ $RETVAL = 0 ] && rm -f /var/lock/subsys/fogretentionrunner
}

restart() {
	echo -n $"Restarting $prog: "
	killproc $DAEMONKILL
	RETVAL=$?
	[ $RETVAL = 0 ] && rm -f /var/lock/subsys/fogretentionrunner
	daemon --user=$RUNASUSER $DAEMONSTART
	RETVAL=$?
	echo
	[ $RETVAL = 0 ] && touch /var/lock/subsys/fogretentionrunner
	return $RETVAL
}

case $1 in
	start)
		start
	;;
	stop)
		stop
	;;
	restart)
		restart
	;;
	status)
		status $DAEMONKILL
		RETVAL=$?
	;;
	*)

	echo $"Usage: $prog {start|stop|restart|status}"
	exit 3
esac

exit $RETVAL
