#!/sbin/openrc-run
### BEGIN INIT INFO
# Provides: FOGSnapinHash
# Required-Start: $local_fs $remote_fs $network $syslog $network $inetd $apache2 $mysql
# Required-Stop: $local_fs $remote_fs $network $syslog $network $inetd
# Default-Start: 2 3 4 5
# Default-Stop: 0 1 6
# X-Interactive: true
# Short-Description: Start/Stop FOGSnapinHash
# Long-Description: Created by Chuck Syperski
# Used to stop and start the FOGSnapinHash Service.
# FOGSnapinHash is used to destribute images through
# Multicast.  Useful to image large amounts of systems simultaneously.
# It serves this ability only if it's the master node.
### END INIT INFO

name=FOGSnapinHash
# The interpreter is named explicitly, and FOGPHPBIN is rewritten by
# installInitScript to whatever php binary this host actually has.
# Alpine ships no unversioned "php" -- the package and the executable
# are both php8x -- and the daemons themselves start "#!/usr/bin/php",
# so running them directly could never work here. See #863.
#
# The daemon path is spelled out rather than built from $name, because
# the two are not always the same -- FOGScheduler's code lives in
# FOGTaskScheduler. These all used $name/$name, so that one pointed at a
# directory which does not exist and start-stop-daemon said exactly that.
command=FOGPHPBIN
command_args="/opt/fog/service/FOGSnapinHash/FOGSnapinHash"
pidfile=/run/fog/$name.pid

# supervise-daemon, not start-stop-daemon with command_background.
#
# These daemons exit immediately when the database is not yet accepting
# connections: FOG's bootstrap fails with "A valid database connection could
# not be made" long before the service's own waitDbReady() is reached. The
# systemd units answer that with Restart=always, RestartSec=1 and
# StartLimitIntervalSec=0, so on a systemd host the daemon is simply restarted
# every second until mariadb is up and nobody ever notices. OpenRC has no
# supervision at all by default, so every FOG daemon started at boot, died
# within a second, and stayed dead -- while starting one BY HAND afterwards
# worked perfectly, which is exactly what made this look like an rc-update
# problem rather than a restart one. respawn_max=0 is unlimited. See #863.
supervisor=supervise-daemon
respawn_delay=1
respawn_max=0

depend() {
        need net
        # Ordering only, never "need": the database is allowed to live on
        # another host, and a storage node has no mariadb at all. This mirrors
        # the systemd units' After=...mysql.service.
        after mariadb mysql
}

start_pre() {
        # /run is a tmpfs, so it is empty on every boot, and nothing else in
        # FOG creates this directory -- the systemd units use no pidfile at
        # all. checkpath is OpenRC's own idempotent mkdir.
        checkpath --directory --mode 0755 /run/fog
}
