#!/bin/openrc-run
### BEGIN INIT INFO
# Provides: FOGPluginRunner
# Required-Start: $local_fs $remote_fs $network $syslog $network $inetd $apache2 $mysql
# Required-Stop: $local_fs $remote_fs $network $syslog $network $inetd
# Default-Start: 2 3 4 5
# Default-Stop: 0 1 6
# X-Interactive: true
# Short-Description: Start/Stop FOGPluginRunner
# Long-Description: Runs background work declared by installed, active plugins.
# FOGPluginRunner is the single daemon behind every plugin's scheduled tasks,
# so that a plugin never has to ship a systemd unit of its own.
### END INIT INFO

name=FOGPluginRunner
command=/opt/fog/service/$name/$name
pidfile=/var/run/fog/$name.pid
command_background="yes"
# ADR 0010: this daemon runs as the web user, not root, because it executes
# third-party plugin code. FOGWEBUSER is rewritten to $apacheuser in the
# installed copy by installInitScript().
command_user="FOGWEBUSER"

depend() {
        need net
}
