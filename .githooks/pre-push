#!/usr/bin/env sh
#
# Runs on "git push" once .githooks is enabled. Refuses a push whose
# committed FOG_VERSION disagrees with the branch state being pushed.
#
# Why the check lives here rather than in a smarter pre-commit hook:
# nothing stamps a version during a rebase, a cherry-pick, a revert or a
# --no-verify commit, and "git commit --amend" re-runs pre-commit against a
# HEAD it is REPLACING, so the +1 that is correct for a new commit counts
# one that will never exist. git tells a pre-commit hook nothing about which
# of those is happening - there is no environment variable and no argument,
# and prepare-commit-msg, which does get told, runs too late to stage a file
# into an ordinary commit. The first moment the answer is knowable is after
# the operation has finished, which is here.
#
# FAILS OPEN on anything it cannot determine - no master ref, no network, a
# detached HEAD, a branch type with no count-based version. Drift is
# corrected by fog-workflows' periodic sweep anyway, so the cost of it is
# spurious CI churn and a release note naming a build that never existed;
# the cost of a hook that guesses wrong is a maintainer unable to push.
# Where those two are not close, guess in favour of the push.

project_dir=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
system_file="$project_dir/packages/web/lib/fog/system.class.php"
[ -f "$system_file" ] || exit 0

head_sha=$(git rev-parse HEAD 2>/dev/null) || exit 0

# Only check when the checked-out branch is among what is being pushed.
# fog-version.sh reasons about HEAD, so it has nothing to say about a push
# of some other ref - and blocking on a version it did not actually measure
# is exactly the wrong-guess case above.
pushing_head=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
    [ -n "$local_sha" ] || continue
    # An all-zero local sha is a branch deletion, which has no tree to check.
    case "$local_sha" in
        *[!0]*) ;;
        *) continue ;;
    esac
    if [ "$local_sha" = "$head_sha" ]; then
        pushing_head=1
    fi
done
[ "$pushing_head" -eq 1 ] || exit 0

gitbranch=$(git branch --show-current 2>/dev/null)
[ -n "$gitbranch" ] || exit 0

fog_version=$(sh "$project_dir/.githooks/lib/fog-version.sh" "$gitbranch" head) || exit 0
expected=$(printf '%s\n' "$fog_version" | sed -n '1p')
channel=$(printf '%s\n' "$fog_version" | sed -n '2p')
drifted=$(printf '%s\n' "$fog_version" | sed -n '3p')

[ "$drifted" = true ] || exit 0
[ -n "$expected" ] || exit 0

current=$(grep "define('FOG_VERSION'" "$system_file" |
    sed "s/.*FOG_VERSION', '\([^']*\)');/\1/")

printf 'pre-push: FOG_VERSION does not match this branch.\n' >&2
printf 'pre-push:\n' >&2
printf 'pre-push:   committed: %s\n' "$current" >&2
printf 'pre-push:   should be: %s\n' "$expected" >&2
printf 'pre-push:\n' >&2
printf 'pre-push: A rebase, cherry-pick or --no-verify commit does not stamp a\n' >&2
printf 'pre-push: version at all, and --amend stamps one too many. Fold the\n' >&2
printf 'pre-push: correct value into HEAD with:\n' >&2
printf 'pre-push:\n' >&2
printf "pre-push:   sh .githooks/lib/apply-fog-version.sh '%s' '%s' \\\\\n" \
    "$expected" "$channel" >&2
printf 'pre-push:     && git add packages/web/lib/fog/system.class.php \\\n' >&2
printf 'pre-push:     && git commit --amend --no-edit --no-verify\n' >&2
printf 'pre-push:\n' >&2
printf 'pre-push: --no-verify on the amend is what stops pre-commit adding the\n' >&2
printf 'pre-push: +1 straight back. To push regardless: git push --no-verify\n' >&2

exit 1
