#!/usr/bin/env sh
#
# Exit on error
# set -e

project_dir=$(git rev-parse --show-toplevel)

psrfix() {
    command -v php-cs-fixer >/dev/null 2>&1 || return
    fixer=$(command -v php-cs-fixer)

    # Only the PHP files staged for THIS commit.
    #
    # This used to run the fixer over all of packages/web and then
    # `git add` the whole directory, which staged every modified file in
    # the working tree whether or not it had anything to do with the
    # commit. In a checkout with two sessions working at once that
    # silently swept one session's work into the other's commit, under a
    # message describing something else entirely.
    #
    # core.quotePath=false so non-ASCII names arrive verbatim rather than
    # octal-escaped. -z is not used because POSIX sh cannot read NUL
    # delimited input; a newline in a filename would still break this, and
    # nothing in this repo has one.
    git -c core.quotePath=false diff --cached --name-only \
        --diff-filter=ACMR -- 'packages/web/*.php' |
    while IFS= read -r f; do
        [ -n "$f" ] || continue

        # Skip files that also have UNSTAGED changes. The fixer rewrites
        # the working-tree copy, so `git add` here would stage the part
        # that was deliberately held back with `git add -p`. A missed PSR2
        # pass is cheaper than committing work someone chose to keep out.
        if ! git diff --quiet -- "$f"; then
            printf 'pre-commit: %s is partially staged, skipping PSR2 fix\n' \
                "$f" >&2
            continue
        fi

        "$fixer" fix "$project_dir/$f" --rules=@PSR2 >/dev/null 2>&1
        git add "$project_dir/$f"
    done
}

updateLanguage() {
    command -v xgettext >/dev/null 2>&1 || return
    command -v msgcat   >/dev/null 2>&1 || return
    command -v msgmerge >/dev/null 2>&1 || return
    xgettext --language=PHP --from-code=UTF-8 --output="$project_dir/packages/web/management/languages/messages.pot" --omit-header --no-location $(find "$project_dir/packages/web/" -name "*.php")
    msgcat --sort-output -o "$project_dir/packages/web/management/languages/messages.pot" "$project_dir/packages/web/management/languages/messages.pot"
    for PO_FILE in $(find "$project_dir/packages/web/management/languages/" -type f -name "*.po"); do
        msgmerge --update --backup=none "$PO_FILE" "$project_dir/packages/web/management/languages/messages.pot" 2>/dev/null >/dev/null
        msgcat --sort-output -o "$PO_FILE" "$PO_FILE"
    done
    git add "$project_dir/packages/web/management/languages/"
}

schemaCheck() {
    command -v php >/dev/null 2>&1 || return 0

    # Only when this commit actually touches the schema or its manifest.
    # Nothing else can make either of these go stale, and a schema gate that
    # fires on unrelated commits is a gate people learn to bypass.
    touched=$(git diff --cached --name-only --diff-filter=ACMR -- \
        'packages/web/commons/schema.php' \
        'packages/web/commons/schema-expected.php' \
        'bin/schema-reference-1.5.php')
    [ -n "$touched" ] || return 0

    # BLOCKING: the manifest no longer describes what schema.php builds.
    # SchemaReconciler compares a live database against that manifest, so a
    # stale one means it silently stops knowing about the new structure and
    # an upgrading 1.5 install never receives it. That is a defect in THIS
    # commit and the fix is one command, so refuse the commit.
    if ! php "$project_dir/bin/schema-manifest.php" check \
        "$project_dir/packages/web"; then
        printf 'pre-commit: schema-expected.php is stale -- commit aborted\n' >&2
        return 1
    fi

    # ADVISORY: structure 1.5 has that 1.6 does not.
    #
    # 1.5.x was supposed to be frozen but keeps taking security-driven
    # schema changes, so this is the check for the inverse failure -- 1.6
    # forgetting to carry one across. It cannot be detected at runtime,
    # because a 1.6 tree has no way to know what 1.5 added.
    #
    # Deliberately NOT blocking: a port that has not happened yet is a real
    # finding but is not necessarily this commit's fault, and blocking every
    # subsequent schema commit until it is resolved would just get the hook
    # disabled. Refresh the reference with:
    #   php bin/schema-manifest.php generate <1.5-web-root> bin/schema-reference-1.5.php
    ref="$project_dir/bin/schema-reference-1.5.php"
    if [ -f "$ref" ]; then
        if ! php "$project_dir/bin/schema-manifest.php" diff "$ref" \
            "$project_dir/packages/web/commons/schema-expected.php"; then
            printf 'pre-commit: WARNING -- 1.6 lacks structure present in 1.5 (see above)\n' >&2
        fi
    fi
    return 0
}

schemaCheck || exit 1

updateLanguage
psrfix



# Define the path to the system file
system_file="$project_dir/packages/web/lib/fog/system.class.php"

# Recompute FOG_VERSION/FOG_CHANNEL for the current branch. The formula is
# shared with fog-workflows' CI check (see .githooks/lib/fog-version.sh) so
# a local commit and CI's periodic sweep never compute two different
# answers for the same branch state.
gitbranch=$(git branch --show-current)
fog_version=$(sh "$project_dir/.githooks/lib/fog-version.sh" $gitbranch 1)
if [ "$(printf '%s\n' "$fog_version" | sed -n '3p')" = "true" ]; then
    sh "$project_dir/.githooks/lib/apply-fog-version.sh" \
        "$(printf '%s\n' "$fog_version" | sed -n '1p')" \
        "$(printf '%s\n' "$fog_version" | sed -n '2p')"

    # Add the modified system file to the staging area
    git add "$system_file"
fi