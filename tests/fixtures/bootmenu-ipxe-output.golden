choose --default fog.local --timeout 3000 target && goto ${target}
:fog.local
imgfetch ${boot-url}/service/ipxe/refind.conf
chain -ar ${boot-url}/service/ipxe/refind_x64.efi || goto MENU
:fog.memtest
